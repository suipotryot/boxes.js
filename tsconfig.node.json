{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.ts-cache/node",
    "tsBuildInfoFile": "./node_modules/.ts-cache/node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
